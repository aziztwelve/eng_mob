{
  "expo": {
    "name": "LingoIQ",
    "slug": "engmob",
    "version": "1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "engmob",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aziztwelve.engmob",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "24DB6F692V"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061A1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aziztwelve.engmob",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "android": {
            "image": "./assets/images/lingoiq-splash-mark.png",
            "imageWidth": 288
          }
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "LingoIQ \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0430\u0448\u0435 \u043f\u0440\u043e\u0438\u0437\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0435\u0433\u043e."
        }
      ],
      "expo-video",
      "./plugins/with-native-brand-splash.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "026ba0a4-2a5e-4987-a2f8-341498507f0c"
      },
      "onboardingV3Enabled": true
    },
    "owner": "aziztwelve"
  }
}
